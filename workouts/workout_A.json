{
  "program": {
    "name": "V-Taper Hypertrophy Program",
    "split_type": "upper_lower",
    "sessions_per_week": 4,
    "lifter": {
      "age": 25,
      "sex": "male",
      "height_in": 72,
      "weight_lb": 160
    },
    "goals": {
