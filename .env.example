# Optional cloud sync (Dexie Cloud). Copy to .env.local and fill in; leave unset to run local-only.
# Create the database with `npx dexie-cloud create` (see README, "Cloud sync (Dexie Cloud)").
# This URL is public (it ships in the app bundle). The secrets live in dexie-cloud.key: never commit it.
VITE_DEXIE_CLOUD_URL=
